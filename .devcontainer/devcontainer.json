
{
  "name": "Azure Data Platform — NYC Taxi",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // ─── Codespaces machine size recommendation ───────────────────────────────
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // ─── Ports ────────────────────────────────────────────────────────────────
  "forwardPorts": [
    8080,   // Airflow UI
    8888,   // Jupyter
    5000,   // Local API / FastAPI
    4040    // Spark UI
  ],
  "portsAttributes": {
    "8080": { "label": "Airflow UI", "onAutoForward": "notify" },
    "8888": { "label": "Jupyter", "onAutoForward": "notify" },
    "5000": { "label": "Local API", "onAutoForward": "silent" },
    "4040": { "label": "Spark UI", "onAutoForward": "silent" }
  },

  // ─── VS Code Extensions ───────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // GitHub Copilot
        "github.copilot",
        "github.copilot-chat",

        // Claude Code (Anthropic)
        "anthropic.claude-code",

        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "charliermarsh.ruff",

        // Databricks
        "databricks.databricks",

        // Terraform
        "hashicorp.terraform",
        "hashicorp.hcl",

        // Bicep
        "ms-azuretools.vscode-bicep",

        // Azure
        "ms-azuretools.vscode-azurefunctions",
        "ms-azure-devops.azure-pipelines",

        // Docker
        "ms-azuretools.vscode-docker",

        // YAML
        "redhat.vscode-yaml",

        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",

        // Markdown / Docs
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",

        // DuckDB
        "evidence.vscode-evidence",

        // General
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens",
        "gruntfuggly.todo-tree"
      ],
      "settings": {
        // Python
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },

        // Editor
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [88],
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,

        // Terminal
        "terminal.integrated.defaultProfile.linux": "bash",

        // Git
        "git.autofetch": true,

        // YAML
        "yaml.schemas": {
          "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml",
          "https://json.schemastore.org/azure-pipelines.json": "azure-pipelines*.yml"
        },

        // Terraform
        "terraform.languageServer.enable": true,

        // Databricks
        "databricks.python.envFile": "${workspaceFolder}/.env"
      }
    }
  },

  // ─── Post-create setup ────────────────────────────────────────────────────
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // ─── Environment variables (non-secret) ──────────────────────────────────
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "ENV": "dev"
  },

  // ─── Features ─────────────────────────────────────────────────────────────
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "latest"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  }
}
